{
  "name": "railroad/doctrine",
  "type": "library",
  "description": "Create doctrine package",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "doctrine/orm": "2.19.*",
    "doctrine/data-fixtures": "^1.5",
    "gedmo/doctrine-extensions": "^3.6",
    "spatie/laravel-fractal": "^6.0",
    "ext-redis": "*",
    "symfony/cache": "^6.0",
    "doctrine/annotations": "^2.0",
    "doctrine/dbal": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "files": [
      "src/Helpers/entity_array_helpers.php"
    ],
    "psr-4": {
      "Railroad\\Doctrine\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Doctrine\\Tests\\": "tests/"
    }
  }
}
